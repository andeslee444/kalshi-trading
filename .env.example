# Kalshi Trading - Environment Variables

# Required: Your Kalshi API key
KALSHI_API_KEY=

# Path to RSA private key (relative to project root or absolute)
KALSHI_KEY_FILE=config/keys/kalshi-demo.pem

# API mode: "demo" or "production"
KALSHI_MODE=demo

# Required when KALSHI_MODE=production (safety guard)
# KALSHI_CONFIRM_PRODUCTION=yes

# Optional: DeepSeek API key for beatrelease-scanner LLM extraction
# (alternatively, store in config/keys/deepseek.txt)
# DEEPSEEK_API_KEY=

# WhatsApp notification phone number (E.164 format, e.g. +14255551234)
# NOTIFICATION_PHONE=

# S3 bucket for syncing trade logs between machines
S3_BUCKET=kalshi-trading-logs
